<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nrec.service.app.mapper.TaskItemMapper">

    <sql id="taskColumns">
        ti.id,
        ti.title,
        ti.description,
        ti.status,
        ti.due_date,
        ti.category_id,
        ti.created_at,
        ti.updated_at,
        tc.name AS category_name
    </sql>

    <select id="selectTaskPage" resultType="com.nrec.service.app.model.dto.TaskDto">
        SELECT
        <include refid="taskColumns"/>
        FROM task_item ti
        LEFT JOIN task_category tc ON ti.category_id = tc.id
        WHERE ti.user_id = #{userId}
        <if test="q.status != null and q.status != ''">
            AND ti.status = #{q.status}
        </if>
        <if test="q.categoryId != null and q.categoryId != ''">
            AND ti.category_id = #{q.categoryId}
        </if>
        <if test="q.keyword != null and q.keyword != ''">
            AND ti.title LIKE CONCAT('%', #{q.keyword}, '%')
        </if>
        <choose>
            <when test="q.sortField == 'title'">ORDER BY ti.title</when>
            <when test="q.sortField == 'dueDate'">ORDER BY ti.due_date</when>
            <when test="q.sortField == 'status'">ORDER BY ti.status</when>
            <when test="q.sortField == 'createdAt'">ORDER BY ti.created_at</when>
            <otherwise>ORDER BY ti.created_at</otherwise>
        </choose>
        <choose>
            <when test="q.sortOrder != null and q.sortOrder == 'desc'">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
    </select>

</mapper>
